# Copy to .env and adjust as needed. docker-compose reads this automatically.

# --- Offline enforcement ----------------------------------------------------
OFFLINE_MODE=true

# --- Paths (inside containers) ----------------------------------------------
MODEL_DIR=/models
DATA_DIR=/data

# --- Databases ---------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=terrex_tiles
DATABASE_URL=postgresql+psycopg2://terrex:terrex@postgres:5432/terrex

# --- Ingestion / embeddings --------------------------------------------------
TILE_SIZE=256
EMBEDDING_DIM=512
PROCESSING_VERSION=terrex-mvp-0.1.0

# --- Hybrid ranking weights (Feature 6) — must not need to sum to 1, code normalises
W_SEMANTIC=0.45
W_GEO=0.15
W_METADATA=0.10
W_QUALITY=0.15
W_CHANGE=0.15

# --- False-alarm suppression thresholds (Feature 5) --------------------------
CLOUD_FRACTION_MAX=0.35
MIN_QUALITY_SCORE=0.4
CHANGE_PROB_THRESHOLD=0.5

# --- Frontend ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

CORS_ORIGINS=*
