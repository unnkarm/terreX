# Copy to .env and adjust as needed. docker-compose reads this automatically.

# --- Offline enforcement ----------------------------------------------------
OFFLINE_MODE=true

# --- Bhoonidhi acquisition only (never used by the FastAPI runtime) ---------
# BHOONIDHI_USER=
# BHOONIDHI_PASS=
# BHOONIDHI_API_BASE=https://bhoonidhi.nrsc.gov.in/bhoonidhi-api

# --- Copernicus Data Space Ecosystem acquisition (scripts/ only) -------------
# Resource Owner Password flow (simplest — uses CDSE account credentials):
# COPERNICUS_USERNAME=your_cdse_email@example.com
# COPERNICUS_PASSWORD=your_cdse_password
# OAuth2 Client Credentials flow (preferred for production):
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=

# --- USGS EarthExplorer M2M acquisition (scripts/ only) ---------------------
# Generate the API key at: https://ers.cr.usgs.gov/profile/access
# (Application Token — not the account password; M2M /login-token endpoint)
# USGS_USERNAME=
# USGS_M2M_API_KEY=

# --- Paths (inside containers) ----------------------------------------------
MODEL_DIR=/models
DATA_DIR=/data

# --- Databases ---------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=terrex_tiles
DATABASE_URL=postgresql+psycopg2://terrex:terrex@postgres:5432/terrex

# --- Ingestion / embeddings --------------------------------------------------
TILE_SIZE=256
EMBEDDING_DIM=512
PROCESSING_VERSION=terrex-mvp-0.1.0

# --- Hybrid ranking weights (Feature 6) — must not need to sum to 1, code normalises
W_SEMANTIC=0.45
W_GEO=0.15
W_METADATA=0.10
W_QUALITY=0.15
W_CHANGE=0.15

# --- False-alarm suppression thresholds (Feature 5) --------------------------
CLOUD_FRACTION_MAX=0.35
MIN_QUALITY_SCORE=0.4
CHANGE_PROB_THRESHOLD=0.5

# --- Frontend ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

CORS_ORIGINS=*

# Local evidence chat (offline Ollama)
CHAT_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
CHAT_SAFE_THRESHOLD_GB=1.5
CHAT_IDLE_TIMEOUT_SECONDS=120
